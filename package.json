{
  "name": "edu-cyberlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EDU-CYBER · Cyber Lab — imparare a difendersi con due macchine Linux vere nel browser",
  "homepage": "https://manzolo.github.io/CyberLab/",
  "repository": {
    "type": "git",
    "url": "https://github.com/manzolo/CyberLab.git"
  },
  "license": "MIT",
  "author": "Andrea Manzi (manzolo)",
  "scripts": {
    "serve": "python3 -m http.server 8803",
    "image": "make -C lab all",
    "test": "node --test tests/content.test.js tests/opzioni.test.js",
    "test:labs": "node tests/labs.mjs",
    "test:consegna": "node tests/regressione-consegna.mjs",
    "test:cwd": "node tests/regressione-cwd.mjs",
    "test:identita": "node tests/regressione-identita.mjs",
    "test:tastiera": "node tests/regressione-tastiera.mjs",
    "test:intestazione": "node tests/regressione-intestazione.mjs",
    "test:regressione": "npm run test:consegna && npm run test:cwd && npm run test:identita && npm run test:tastiera",
    "spike": "node tools/spike.mjs",
    "e2e": "node tools/e2e.mjs http://127.0.0.1:8803/",
    "new-chapter": "node tools/new-chapter.mjs",
    "screenshot": "node tools/screenshot.mjs"
  }
}
